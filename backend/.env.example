DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_NAME=avian_db
DB_HOST=postgres-service
DB_PORT=5432
PASSWORD_HASH_ITERATIONS=210000
AVIAN_API_HOST=140.136.151.88
AVIAN_HTTPS_PORT=8443
# TCP 80 must reach Caddy's ACME listener (directly or via an existing Caddy).
# Change host ports if another local application already uses them.
AVIAN_HTTP_PORT=8000
AVIAN_MATCHMAKER_PORT=8080
AVIAN_POSTGRES_PORT=5432
ROOM_MODE=static
GAME_TRANSPORT=websocket
WORLD_ENDPOINT=wss://${AVIAN_API_HOST}:${AVIAN_HTTPS_PORT}/game/30080
ROOM_PUBLIC_BASE_URL=wss://${AVIAN_API_HOST}:${AVIAN_HTTPS_PORT}/game
AVIAN_GAME_GATEWAY_HOST=avian-cluster-control-plane
STATIC_ROOM_SEED=100000
ROOM_ENDPOINT_HOST=${AVIAN_API_HOST}
ROOM_NODE_PORT_START=30081
ROOM_NODE_PORT_END=30084
ROOM_IMAGE=avian-dedicated-server:v1
ROOM_NAMESPACE=default
ROOM_GAME_PORT=7777
ROOM_CLEANUP_GRACE_SECONDS=30
ROOM_CLEANUP_INTERVAL_SECONDS=10
KUBECONFIG=/kube/config
KUBERNETES_API_HOST=
KUBERNETES_VERIFY_SSL=true
